{
  "name": "astrarocket-web",
  "version": "0.5.34",
  "version_major": 0,
  "version_minor": 5,
  "version_patch": 34,
  "version_date": "11/21/2026",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "AstraRocket: browser UI for the OpenRocket engine",
  "author": "thZero.com",
  "author_url": "https://www.thzero.com",
  "copyright": "2026",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstraRocket/simulator.git"
  },
  "bugs": {
    "url": "https://github.com/AstraRocket/simulator/issues"
  },
  "wiki": {
    "url": "https://astrarocket.github.io/simulator/docs/"
  },
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "openrocket:build": "node scripts/build-openrocket.mjs",
    "build": "npm run typecheck && npm run lint && vite build",
    "build:inc": "library-cli --updateversion --pi --silent && prettier --write --log-level warn package.json",
    "check": "node scripts/check.mjs",
    "check:digests": "node scripts/check-catalog-digests.mjs",
    "check:fields": "node scripts/check-desktop-fields.mjs",
    "check:ork": "node scripts/check-ork-opens.mjs",
    "dev": "vite",
    "diff:motors": "node scripts/diff-motors.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "dupes": "jscpd",
    "gate:e2e": "playwright test",
    "gate:e2e:core": "node scripts/e2e-core.mjs",
    "test:e2e:sections": "node scripts/e2e-sections.mjs",
    "e2e:offline-data": "node scripts/check-offline-data.mjs",
    "e2e:offline-help": "node scripts/check-offline-help.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "node scripts/check-update-flow.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:icons": "node scripts/gen-icons.mjs",
    "knip": "knip",
    "lint": "eslint . --max-warnings 0",
    "metrics": "node scripts/quality-metrics.mjs",
    "preview": "vite preview",
    "spell": "cspell --no-progress --config ../cspell.json",
    "sync:all": "npm run openrocket:build && npm run sync:motors && npm run sync:motor-digests && npm run sync:materials && npm run sync:components && npm run sync:preset-digests && npm run check:digests && npm run sync:examples && npm run sync:contributors",
    "sync:components": "node scripts/sync-components.mjs",
    "sync:contributors": "node scripts/sync-contributors.mjs",
    "sync:examples": "node scripts/sync-examples.mjs",
    "sync:materials": "node scripts/sync-materials.mjs",
    "sync:motor-digests": "node scripts/sync-motor-digests.mjs",
    "sync:motors": "node scripts/sync-motors.mjs",
    "sync:preset-digests": "node scripts/sync-preset-digests.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:quick": "npm run typecheck && npm run lint && vitest run",
    "test:types": "node scripts/check.mjs types",
    "test:lint": "node scripts/check.mjs lint",
    "test:build": "node scripts/check.mjs build",
    "test:docs": "node scripts/check.mjs docs",
    "test:format": "node scripts/check.mjs format",
    "test:spell": "node scripts/check.mjs spell",
    "test:knip": "node scripts/check.mjs knip",
    "test:dupes": "node scripts/check.mjs dupes",
    "test:unit": "node scripts/check.mjs unit",
    "test:repo": "node scripts/check.mjs repo",
    "test:desktop": "node scripts/check.mjs desktop",
    "test:helpers": "node scripts/check.mjs helpers",
    "test:e2e": "node scripts/check.mjs e2e",
    "test:engine": "node scripts/check.mjs engine",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.node.json",
    "updates": "npx npm-check-updates"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "fflate": "^0.8.3",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "jspdf": "^4.2.1",
    "mustache": "^4.2.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "^18.0.2",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@thzero/library_cli": "^0.18.46",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "cspell": "10.5.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jscpd": "5.4.3",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "prettier": "3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "three-stdlib": "^2.36.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
